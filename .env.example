# Spotify Web API (server-side only — never expose the secret to the browser)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional ISO 3166-1 alpha-2 market for catalog availability. Default: US
SPOTIFY_MARKET=US

# Reserved for a future Authorization Code flow / Web Playback SDK.
# Not required for search, embeds, or "Open in Spotify".
# Use 127.0.0.1 (not localhost) for local Spotify apps.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
