# Spotify Web API (server-side only — never expose the secret to the browser)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional ISO 3166-1 alpha-2 market for catalog availability. Default: US
SPOTIFY_MARKET=US

# Authorization Code + PKCE for the in-page player and "Save playlist".
# In the Spotify Dashboard, Redirect URIs must include exactly:
#   https://classical-portal.vercel.app/api/spotify/callback
#   http://127.0.0.1:3000/api/spotify/callback
# Use 127.0.0.1 (not localhost) for local Spotify apps.
# Set SPOTIFY_REDIRECT_URI to the URI for this environment. If unset, the app
# uses {origin}/api/spotify/callback, which still has to be listed in the Dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
