# Spotify Web API (server-side only — never expose the secret to the browser)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional ISO 3166-1 alpha-2 market for catalog availability. Default: US.
# Also the market half of the durable match key (work id + market).
SPOTIFY_MARKET=US

# Durable Spotify match cache. Positive rows never expire; empty searches expire after 7 days.
# Run supabase/spotify_work_matches.sql once, then set the service role key on the server.
# Never prefix the service role key with NEXT_PUBLIC. The anon key must not write this table.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Playback uses the Spotify embed in the browser. Matching uses the client
# credentials above. No redirect URI or user login through this app.

# Optional footer Donate link (Stripe Payment Link). Leave unset or empty to hide it.
# Test mode. Replace with the Live Payment Link after the Stripe account is activated.
NEXT_PUBLIC_DONATE_URL=https://buy.stripe.com/test_cNi28t7RH7ik76rfMR4gg00
